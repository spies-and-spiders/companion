;; ============================================================================
;; sns-companion — example configuration
;; ============================================================================
;; This is the primary way a DM defines loot types and rules.
;; Copy it to `config.edn` in the directory you run the app from, or
;; point at it explicitly:
;;
;;     java -jar companion-<version>-standalone.jar --config examples/config.edn
;;
;; With no `--config`, the app looks for `config.edn` (then `config.json`) in the
;; working directory.
;;
;; The file is read with aero, so if you provide a config file using EDN, you can
;; use any of these reader tags - https://github.com/juxt/aero#tag-literals.
;; ============================================================================

{;; --- HTTP server -----------------------------------------------------------
 ;; Optional. Defaults to 127.0.0.1:8080 when omitted. The default binds to
 ;; loopback only; set :host "0.0.0.0" to let players on the same network reach
 ;; the UI.
 :server {:host "127.0.0.1"
          :port 8080}

 ;; --- storage ---------------------------------------------------------------
 ;; Where stateful plugin state is kept, as named collections of key -> value.
 ;; Optional; defaults to in-memory (nothing survives a run).
 ;;
 ;;   :memory  — in memory. The default when :storage is absent.
 ;;   :file    — one EDN file per collection under :dir (default "./state").
 ;;              The files are the source of truth: edit them by hand while the
 ;;              app runs and the next read picks the change up.
 ;;   :browser — IndexedDB in the DM's browser; the server holds nothing. State
 ;;              is device-local, so use the export button to take it with you.
 ;;
 ;; Settings only one backend understands nest under that backend's key; only
 ;; :file has any (:dir). See docs/storage.md.
 :storage {:backend :file
           :file    {:dir "./state"}}

 ;; --- plugins ---------------------------------------------------------------
 ;; The loot types available in the UI. Five kinds:
 ;;
 ;;   :builtin — a generator shipped in this app: the :id alone selects it
 ;;              (:divine-dust, :relics, :social). An optional
 ;;              :builtin {:entrypoint <var>} overrides the lookup.
 ;;   :data    — a code-free loot type defined entirely in an EDN/JSON spec
 ;;              file (:source is a filesystem path, e.g. relative to config.edn),
 ;;              or written straight into this file under :inline (which wins
 ;;              over :source).
 ;;   :cli     — shell out to any external program (any language). See
 ;;              examples/cli-plugin/weather.py.
 ;;   :ffi     — call a C-ABI symbol in a shared library, exchanging the same
 ;;              JSON as :cli. Works in the native image (unlike :jar). See
 ;;              examples/ffi-plugin/ (C, Go, and Rust).
 ;;   :wasm    — run a WASI module on GraalWASM, exchanging the same JSON as
 ;;              :cli over its stdio: in-process and native-image-capable like
 ;;              :ffi, but sandboxed and one build for every platform. See
 ;;              examples/wasm-plugin/loot.go.
 ;;   :jar     — a generator from an external library jar on disk. Only
 ;;              available when running the app via java -jar
 ;;
 ;; Every plugin needs a unique :id; that id is what the :loot-table references.
 ;; Keys every plugin shares (:id, :label, :utility?, :hidden?, …) sit at the top
 ;; level; the ones only one :type understands nest under that type's own key.
 ;;
 ;; Any plugin may add :hidden? true to keep itself out of the UI's loot-type
 ;; picker, so it can only turn up by rolling the :loot-table. (It still appears
 ;; on the picker while it is the type on screen.)
 :plugins [{:type :builtin :id :divine-dust}
           {:type :builtin :id :relics}
              ;; The Group Deception & Persuasion tracker: a manual character
              ;; table (name, two bonuses, present?) that the UI renders an
              ;; editor for, plus one action rolling 1d20 + the group bonus.
              ;; Any plugin can declare such a table with :store/manual.
           {:type :builtin :id :social}
           {:type :data :id :uniques :data {:source "data/uniques.edn"}}
           {:type :data :id :rings :data {:source "data/rings.edn"}}
              ;; The same DSL, written inline: handy for a short table you don't
              ;; want in its own file. :hidden? keeps it off the picker, so an
              ;; omen only ever arrives as a surprise off the loot-table below.
           {:type    :data
            :id      :omens
            :hidden? true
            :data    {:inline {:label "Omen"
                               :items [{:text "A crow lands on the wagon."}
                                       {:text "The lanterns gutter without wind."}]
                               :title "{{text}}"}}}
              ;; A loot generator in any language. :cli's :command is the program
              ;; plus args; the engine pipes the request context as JSON on stdin and
              ;; reads a friendly view-model as JSON on stdout. :label is what the
              ;; UI shows (defaults to the id). Add :utility? true to group it
              ;; under Utilities instead of Loot Types (and bar it from the
              ;; :loot-table).
           {:type     :cli
            :id       :weather
            :utility? true
            :label    "Weather"
            :cli      {:command ["python3" "examples/cli-plugin/weather.py"]}}
              ;; A C-ABI shared library, exchanging the same JSON as :cli but in
              ;; process (so it works in the native image, unlike :jar). Build one
              ;; of the examples first, e.g. from examples/ffi-plugin/:
              ;;   cc -shared -fPIC -o libloot.dylib loot.c   (or loot.go, loot.rs)
              ;; then point :library at it. :symbol is the generator; :free-symbol
              ;; (optional) is called on the returned pointer once its bytes are
              ;; read. Same :label/:utility?/:hidden? options as any other plugin.
           #_{:type :ffi
              :id   :ffi-loot
              :ffi  {:library     "plugins/libloot.dylib"
                     :symbol      "generate"
                     :free-symbol "loot_free"}}
              ;; A WASI module, exchanging the same JSON as :cli over its stdio
              ;; but in process — so it works in the native image (unlike :jar)
              ;; with no subprocess (unlike :cli) and no ABI to hand-roll
              ;; (unlike :ffi). One build runs on every platform. Build the
              ;; example first, from examples/wasm-plugin/:
              ;;   GOOS=wasip1 GOARCH=wasm go build -o loot.wasm loot.go
              ;; then point :module at it. Same :label/:utility?/:hidden?
              ;; options as any other plugin.
           #_{:type :wasm
              :id   :wasm-loot
              :wasm {:module "plugins/loot.wasm"
                        ;; Both optional. :args are the module's program
                        ;; arguments; :dirs maps a guest path to a host
                        ;; directory, and a module with no :dirs gets no
                        ;; filesystem at all — it sees only what you map.
                     :args   ["enchant"]
                     :dirs   {"/data" "./data"}}}
              ;; A generator from an external jar at :jar's :path, which names
              ;; its generator: either an :entrypoint Clojure var, or — for
              ;; plugins written in Java/Kotlin/Scala with no Clojure — a :class
              ;; with a 0-arity constructor implementing the SPI interfaces.
              ;; The jar is added to the runtime classpath at startup. (If your
              ;; host forbids classpath mutation, put the jar on the JVM -cp
              ;; instead.)
           #_{:type :jar
              :id   :homebrew
              :jar  {:path       "plugins/homebrew-loot.jar"
                     :entrypoint my.homebrew.loot/generator}}
           #_{:type :jar
              :id   :homebrew-java
              :jar  {:path  "plugins/homebrew-java.jar"
                     :class "my.homebrew.JavaLoot"}}]

 ;; --- randoms ---------------------------------------------------------------
 ;; Optional. Named lists any plugin can draw a value from. A plugin *declares*
 ;; a variable — in a mod's :vars, or a :data entry's :item/vars — and its
 ;; template refers to it by name:
 ;;
 ;;   {:vars     {:feat {:random :feats}}
 ;;    :template "You gain the {{ feat }} feat."}
 ;;
 ;;   {:vars     {:skills {:random :without-replacement :amount 2 :preset :skills}}
 ;;    :template "Proficiency in {{ skills.[0] }} and {{ skills.[1] }}."}
 ;;
 ;; Name a var for what it holds: the editor labels it from the id, so :feat
 ;; shows as "Feat" with nothing further to declare. (A numeric segment needs
 ;; brackets — {{ skills.0 }} is a Handlebars parse error.)
 ;;
 ;; The draw happens once, server-side, with the request's seeded rng; the value
 ;; then travels to the browser with the preset's vocabulary attached, so a DM
 ;; can edit it as a combobox without retyping the prose around it.
 ;;
 ;; The app ships no vocabulary of its own — these lists are your campaign's
 ;; content. Two presets are always available regardless: :literal (values
 ;; written where the var is declared, under :options) and :without-replacement
 ;; (draw N distinct values from another preset).
 :randoms {:feats        ["Alert" "Athlete" "Brawler" "Charger" "Durable"]
           :skills       ["Athletics" "Deception" "Insight" "Stealth"]
           :damage-types ["acid" "cold" "fire" "lightning" "necrotic" "radiant"]}

 ;; --- result words ----------------------------------------------------------
 ;; Every generated result is tagged with two words drawn from this vocabulary,
 ;; shown in the UI behind the encircled W and spoilered into a Discord post.
 ;; A built-in word list is used when neither key is set; :words replaces it
 ;; outright, :extra-words adds to it.
 ;; :extra-words ["mimic" "gelatinous"]

 ;; --- reporting -------------------------------------------------------------
 ;; Optional. Enables the per-item "Send to Discord" button, posting the rolled
 ;; loot to a webhook as a rich embed.
 ;;
 ;; :webhook-url is a secret — read it from the environment via #env rather than
 ;; committing it. :username and :avatar-url are optional overrides for how the
 ;; bot message appears.
 ;;
 ;; Note that #env tags are not supported from .json config files, so these values
 ;; would need to be inlined
 :reporting {:backend :discord
             :discord {:webhook-url #env DISCORD_WEBHOOK_URL
                       :username    "Loot Goblin"
                       :avatar-url  #env DISCORD_AVATAR_URL}}

 ;; --- loot table ------------------------------------------------------------
 ;; The weighted draw used by the "random loot" button. Each :id must match a
 ;; plugin above; :weight is the relative chance (defaults to 1 when omitted).
 ;; Utility plugins are not loot and cannot appear here.
 :loot-table [{:id :divine-dust :weight 40}
              {:id :uniques :weight 25}
              {:id :rings :weight 20}
              {:id :relics :weight 15}
              ;; :omens is :hidden?, so this is the only way it ever comes up.
              {:id :omens :weight 5}]}
