{
  "label": "Json Spec",
  "inputs": [
    {"id": "who", "label": "Who", "type": "text"}
  ],
  "tables": {
    "uniques": [
      {"name": "Only One", "mods": [{"effect": "Effect A", "tags": ["accuracy"]}]}
    ]
  },
  "let": {"unique": {"choose": "uniques"}},
  "view-model": {
    "loot/title": "{{unique.name}} for {{who}}",
    "loot/sections": [
      {"section/heading": "Mods",
       "section/items": {"data/each": ["unique", "mods"],
                         "data/as": {"item/body": {"data/field": "effect"},
                                     "item/metadata": {"data/field": "tags"}}}}
    ]
  }
}
